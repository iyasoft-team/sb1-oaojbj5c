<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <ResourceId>/subscriptions/4e9ece93-a1e2-4096-8fb6-d1b0b38838cf/resourcegroups/Madrasaty-API_group/providers/Microsoft.Web/sites/Madrasaty-API</ResourceId>
    <ResourceGroup>Madrasaty-API_group</ResourceGroup>
    <ApiResourceId>/subscriptions/4e9ece93-a1e2-4096-8fb6-d1b0b38838cf/resourceGroups/Madrasaty-API_group/providers/Microsoft.ApiManagement/service/QuranApi-Prod/apis/QuranApi</ApiResourceId>
    <OpenApiDocumentName>v1</OpenApiDocumentName>
    <UpdateApiOnPublish>true</UpdateApiOnPublish>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://madrasaty-api.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>03d96f9a-cfa6-490a-a5e6-d75b8b41ff76</ProjectGuid>
